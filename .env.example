# ═══════════════════════════════════════════════════════
# Sistema de Rifa — variáveis de ambiente
# Copie para .env e preencha. NUNCA faça commit do .env.
# ═══════════════════════════════════════════════════════

# ── Banco de dados ──
DATABASE_URL="postgresql://usuario:senha@localhost:5432/rifa?schema=public"

# ── Autenticação dos painéis (afiliado e organizadora) ──
# Gere um segredo forte:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=""
SESSAO_DURACAO_HORAS="8"

# ── Mercado Pago (cobrança PIX) ──
# Credenciais em https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=""
# Segredo da assinatura do webhook (painel > Webhooks > Configurar notificações)
MERCADOPAGO_WEBHOOK_SECRET=""

# ── Aplicação ──
# URL pública, usada no link de indicação do afiliado e no retorno do pagamento
NEXT_PUBLIC_APP_URL="http://localhost:3000"
