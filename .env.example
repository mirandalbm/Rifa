# ═══════════════════════════════════════════════════════
# Sistema de Rifa — variáveis de ambiente
# Copie para .env e preencha. NUNCA faça commit do .env.
# ═══════════════════════════════════════════════════════

# ── Banco de dados ──
# Este valor já funciona com o banco do docker-compose.yml (docker compose up -d).
DATABASE_URL="postgresql://rifa:rifa@localhost:5432/rifa?schema=public"

# ── Autenticação dos painéis (afiliado e organizadora) ──
# Gere um segredo forte:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=""
SESSAO_DURACAO_HORAS="8"

# ── Mercado Pago (cobrança PIX) ──
# Credenciais em https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=""
# Segredo da assinatura do webhook (painel > Webhooks > Configurar notificações)
MERCADOPAGO_WEBHOOK_SECRET=""

# ── E-mail de confirmação de compra (opcional) ──
# Sem estas variáveis o sistema funciona normalmente, apenas não envia e-mail.
# Chave em https://resend.com/api-keys
RESEND_API_KEY=""
# Remetente verificado no provedor, ex: "Rifa Solidária <rifa@suaong.org.br>"
EMAIL_REMETENTE=""

# ── Aplicação ──
# URL pública, usada no link de indicação do afiliado e no retorno do pagamento
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Mídia das rifas (fotos e vídeo do prêmio) ──
# Diretório onde os arquivos enviados ficam. Em produção aponte para um volume
# persistente — disco de container é apagado a cada deploy.
MIDIA_DIR="./midia"
