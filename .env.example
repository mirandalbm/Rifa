# Copie para `.env` e ajuste o que precisar:  cp .env.example .env
#
# Em desenvolvimento, só DATABASE_URL e SESSION_SECRET são obrigatórios. Todo
# o resto tem substituto de mentira: sem credencial de Pix o pagamento é
# simulado por um botão na tela, e sem token de WhatsApp o código de acesso
# aparece no terminal do servidor.

# ---- obrigatório ----

# Porta do Postgres na SUA máquina. Se a 5433 já estiver ocupada, troque aqui:
# o docker-compose.yml lê a mesma variável, então os dois nunca saem de sincronia.
DB_PORT=5433

# Combina com o docker-compose.yml deste repositório.
DATABASE_URL="postgres://rifa:rifa@127.0.0.1:5433/rifa"

# Assina o cookie de sessão. Em produção, use um valor longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="troque-isto-em-producao"

# ---- opcional em desenvolvimento ----

PORT=5000
# Usado nos links que vão nas mensagens.
PUBLIC_BASE_URL="http://localhost:5000"

# Dias de carência da comissão, contra estorno. Padrão 7.
# REFUND_WINDOW_DAYS=7

# ---- produção ----

# Pagamento. Sem as duas, o provedor é o falso (`dev`).
# PAYMENT_PROVIDER=mercadopago
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=

# Mídia. Sem elas, os arquivos vão para a pasta ./uploads.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=

# Disco da mídia. Em produção é o volume (no Railway, o caminho de montagem,
# ex.: /data) — fora do volume, tudo some a cada publicação.
# UPLOAD_DIR=/data

# Cópia de segurança da mídia: cada arquivo gravado no disco vai também para
# este bucket S3 (Cloudflare R2, bucket do Railway, AWS…), na hora. O que
# sumir do disco volta sozinho da cópia. Sem BACKUP_S3_BUCKET, desligada.
# BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_REGION=auto
# BACKUP_S3_PATH_STYLE=false

# WhatsApp. Sem o token, a mensagem sai no console.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
