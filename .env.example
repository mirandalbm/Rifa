# Copie para .env e preencha. Variáveis definidas no ambiente têm prioridade sobre este arquivo.

# --- Obrigatórias -----------------------------------------------------------
# PostgreSQL (local ou hospedado). Para provedores que exigem TLS, acrescente ?sslmode=require
DATABASE_URL=postgres://usuario:senha@localhost:5432/darknews
# Segredo longo e aleatório para assinar as sessões (ex.: openssl rand -hex 32)
SESSION_SECRET=
# Segredo longo e aleatório para criptografar as chaves de API salvas no banco
API_ENCRYPTION_KEY=
# Endereço público do sistema (usado nos links de e-mail e no retorno do Google)
APP_URL=http://localhost:5000

# --- Quem pode acessar --------------------------------------------------------
# Listas separadas por vírgula. Se ficarem vazias, qualquer pessoa que criar conta acessa o painel.
ALLOWED_EMAILS=voce@exemplo.com
ALLOWED_PHONES=+5511999999999
# Quem pode usar as ferramentas de desenvolvedor (terminal, editor de arquivos, SQL).
# Se ficarem vazias, valem as listas ALLOWED_*.
ADMIN_EMAILS=
ADMIN_PHONES=

# --- Login com Google (opcional) ---------------------------------------------
# Crie um "OAuth client ID" (tipo Web) em https://console.cloud.google.com/apis/credentials
# e cadastre o redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Envio de e-mail (confirmação de conta e recuperação de senha) ----------
# Sem isso, os links aparecem no log do servidor.
SENDGRID_API_KEY=
EMAIL_FROM=

# --- Login por telefone (SMS via Twilio) --------------------------------------
# Sem isso, o login por telefone só funciona em desenvolvimento (o código aparece no log).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Código do país usado quando o número é digitado sem "+" (55 = Brasil)
DEFAULT_COUNTRY_CODE=55

# --- Serviços de conteúdo (opcionais) -----------------------------------------
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=
NEWSAPI_KEY=
NEWSDATA_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=

# --- Servidor -------------------------------------------------------------------
PORT=5000
